{
  "name": "@nextreport/engine",
  "version": "0.2.0",
  "description": "Modern, schema-driven document rendering engine. Design visually. Render via API. Integrate anywhere.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "reporting",
    "report",
    "engine",
    "pdf",
    "html",
    "invoice",
    "document",
    "template",
    "schema",
    "designer",
    "viewer",
    "rendering",
    "json",
    "dsl",
    "typescript",
    "react",
    "nextjs",
    "headless",
    "api"
  ],
  "author": "NextReport Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nextreport/engine"
  },
  "homepage": "https://github.com/nextreport/engine#readme",
  "bugs": {
    "url": "https://github.com/nextreport/engine/issues"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "puppeteer": "^24.40.0"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nextreport/schema": "workspace:*",
    "@nextreport/engine-core": "workspace:*",
    "@nextreport/renderer-html": "workspace:*",
    "@nextreport/renderer-pdf": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2"
  }
}
