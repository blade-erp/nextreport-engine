{
  "name": "@nextreport/renderer-pdf",
  "version": "0.2.1",
  "description": "PDF renderer for NextReport Engine. Converts HTML to PDF via Puppeteer.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextreport/engine.git",
    "directory": "packages/renderer-pdf"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@nextreport/engine-core": "workspace:*",
    "@nextreport/renderer-html": "workspace:*",
    "@nextreport/schema": "workspace:*",
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
