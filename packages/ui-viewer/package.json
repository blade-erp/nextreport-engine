{
  "name": "@nextreport/ui-viewer",
  "version": "0.2.1",
  "description": "Report viewer React component for NextReport Engine. Pagination, print, and PDF export.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
