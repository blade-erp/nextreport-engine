{
  "name": "@nextreport/ui-designer",
  "version": "0.2.1",
  "description": "Visual report designer React component for NextReport Engine. Drag & drop, property editor, live preview.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "zustand": "^5.0.0",
    "immer": "^11.1.4",
    "@nextreport/canvas": "workspace:*",
    "@nextreport/schema": "workspace:*",
    "@nextreport/engine-core": "workspace:*",
    "@nextreport/renderer-html": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextreport/engine",
    "directory": "packages/ui-designer"
  },
  "homepage": "https://github.com/nextreport/engine#readme"
}
