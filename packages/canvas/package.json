{
  "name": "@nextreport/canvas",
  "version": "0.2.1",
  "description": "Canvas abstraction layer for NextReport Engine. Ports & adapters pattern with Konva.js implementation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
